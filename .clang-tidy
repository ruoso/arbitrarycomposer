# Curated profile (design doc 16). Every disabled check carries a reason.
# Runs per-push under `scripts/check_tidy.py` (ci.yml job `tidy`). The baseline in
# `scripts/tidy_baseline.json` reached ZERO on 2026-07-24, so this is now an
# ordinary gate: any finding fails the push. The ratchet machinery stays as the
# enforcement mechanism (and as the way back, should a check ever be added whose
# backlog cannot be cleared in one change).
#
# The list opens with `-*` so the profile is exactly what is written here. Without
# it clang-tidy folds in its own default set — which is how `clang-analyzer-*` got
# enforced here for nineteen days without anyone choosing it (see below).
#
# Disabled:
#   bugprone-easily-swappable-parameters — geometry/color APIs are
#     inherently (x, y) / (r, g, b, a) shaped; the check is all noise here.
#   modernize-use-trailing-return-type — style choice: leading return types.
#
# Two checks are additionally disabled for TEST bodies only, by
# `scripts/check_tidy.py` (see `TEST_DISABLED_CHECKS` there for the reasons):
# bugprone-unchecked-optional-access and
# bugprone-implicit-widening-of-multiplication-result. Both stay in force for
# library code. The scoping lives in the script rather than in twenty-one copies
# of this file, one per `t/` directory.
#   clang-analyzer-* — never part of the curated list in doc 16; it arrived via
#     clang-tidy's default checks. It CRASHES clang-tidy 20.1.0 on
#     src/base/rational_time.cpp (`__builtin_mul_overflow` over `__int128`,
#     ExprEngine, exit 245), and its path-sensitive results shift with the
#     analyzer's own version, which a per-push ratchet cannot absorb. It found 7
#     of 513 findings when it ran — a potential leak in document_serialize.cpp
#     and a divide-by-zero among them, worth a deliberate one-off analyzer pass
#     rather than a lane that cannot complete.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  concurrency-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-equals-default,
  readability-identifier-naming
WarningsAsErrors: '*'
# Analyze this repo's headers, not just the .cpp files that include them: a large
# share of arbc is header-inline (accessors, the publish seams, the small-value
# types), and clang-tidy's default -- diagnostics from the main file only -- left
# all of it unlinted. FetchContent unpacks Catch2 and nlohmann_json under the
# build tree, whose paths contain `/src/`, so the exclusion matches `_deps`
# directly rather than trying to spell "not third-party" as a path shape.
# (`scripts/check_tidy.py` dedupes, so a header shared by 40 TUs still counts once.)
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
CheckOptions:
  # This check is an OPTIONAL analysis, not a null-smart-pointer one. Its
  # smart-pointer mode flagged `model->…` on a `unique_ptr` freshly constructed
  # from `new` (src/model/model.cpp) -- unreachable, since a failed `new` throws.
  bugprone-unchecked-optional-access.IgnoreSmartPointerDereference: true
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.PrivateMemberPrefix: d_
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.StaticVariablePrefix: s_
  readability-identifier-naming.StaticVariableCase: lower_case
  readability-identifier-naming.ConstexprVariableCase: lower_case
